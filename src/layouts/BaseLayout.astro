---
import '../../styles/main.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    heroClass: string;
}

const { heroClass } = Astro.props;
---

<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="author" content="Slow Boat Education">
        <meta name="description" content="Slow Boat Education">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Slow Boat Education</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Krona+One&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Syne:wght@400..800&display=swap" rel="stylesheet">
    </head>
    <body>
        <div class={heroClass}>
            <Header />
            <slot name="hero" />
        </div>
        <slot />
        <Footer />
        <slot name="scripts" />
    </body>
</html>
